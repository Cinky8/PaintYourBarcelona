# Hash of the /admin password — create it with `npm run set-password` (never store the plain password)
ADMIN_PASSWORD_HASH=
# Random string, 32+ characters, used to sign the admin login cookie
SESSION_SECRET=
# Upstash Redis (added automatically when you connect Upstash in Vercel → Storage).
# Leave empty locally to store events in .data/events.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Email for booking confirmations (Gmail: use an App Password, not your normal password —
# Google Account → Security → 2-Step Verification → App passwords).
# Locally, leave empty to write emails to .data/outbox/ instead of sending them.
SMTP_USER=paintyourbarcelona@gmail.com
SMTP_PASS=
# Optional — defaults shown
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# ORGANIZER_EMAIL=paintyourbarcelona@gmail.com
